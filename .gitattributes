# Normalise line endings to LF in the repository on every OS.
* text=auto eol=lf

# PowerShell scripts keep CRLF so Windows PowerShell 5.1 reads them reliably.
*.ps1 text eol=crlf

# Binary files
*.docx binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Vendored libraries: store byte-for-byte (SHA-256 recorded in static/vendor/README.md).
static/vendor/*.js -text
